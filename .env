# ==============================================================================
# QENZIX QUANTUM KEY DISTRIBUTION LABORATORY - ACTIVE ENVIRONMENT
# ==============================================================================

# Base URL path for GitHub Pages deployment
PUBLIC_URL=/Quantum-Keydistribution

# Application Metadata & Theme
REACT_APP_SITE_TITLE=QENZIX | Quantum Key Distribution Laboratory
REACT_APP_VERSION=1.0.0
REACT_APP_DEFAULT_THEME=dark

# 3D Pointcloud Model Identifiers (Sketchfab)
REACT_APP_SKETCHFAB_MODEL_ID=5204389502ba46e293d619dde7b94c2b
REACT_APP_SKETCHFAB_WAVE_ID=27528a65990c412eae734d5f4b14da04

# Simulation Dynamic Parameters
REACT_APP_SIMULATION_MAX_SPEED=5.0
REACT_APP_DEFAULT_KEY_SIZE=2048
REACT_APP_QBER_ABORT_THRESHOLD=11.0

# Repository Link
REACT_APP_REPOSITORY_URL=https://github.com/Charan-718/Quantum-Keydistribution

# Build Optimizations
GENERATE_SOURCEMAP=false
