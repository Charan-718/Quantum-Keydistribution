# ==============================================================================
# QENZIX QUANTUM KEY DISTRIBUTION LABORATORY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the project root to override or customize settings.
# All environment variables consumed in React must begin with 'REACT_APP_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT & ROUTING
# ------------------------------------------------------------------------------
# Base URL path when hosting in a subfolder (e.g. GitHub Pages).
# For custom domain or root hosting, change this to '/' or leave empty.
PUBLIC_URL=/Quantum-Keydistribution

# ------------------------------------------------------------------------------
# 2. APPLICATION METADATA & BRANDING
# ------------------------------------------------------------------------------
REACT_APP_SITE_TITLE=QENZIX | Quantum Key Distribution Laboratory
REACT_APP_VERSION=1.0.0
# Initial theme mode: 'dark' (Charcoal Obsidian) or 'light' (Porcelain Silver)
REACT_APP_DEFAULT_THEME=dark

# ------------------------------------------------------------------------------
# 3. 3D POINTCLOUD & WAVE HORIZON INTEGRATIONS (SKETCHFAB EMBED IDENTIFIERS)
# ------------------------------------------------------------------------------
# Primary upper 3D pointcloud model: Abstract Pointcloud (Frontal symmetric)
REACT_APP_SKETCHFAB_MODEL_ID=5204389502ba46e293d619dde7b94c2b

# Ambient 3D wave horizon dynamics model (Zero gap bottom floor)
REACT_APP_SKETCHFAB_WAVE_ID=27528a65990c412eae734d5f4b14da04

# ------------------------------------------------------------------------------
# 4. SIMULATION DYNAMICS & CRYPTOGRAPHIC THRESHOLDS
# ------------------------------------------------------------------------------
# Maximum simulation clock speed multiplier (0.1x to 5.0x)
REACT_APP_SIMULATION_MAX_SPEED=5.0

# Default classical RSA/Diffie-Hellman asymmetric key size in bits (512, 1024, 2048, 3072, 4096)
REACT_APP_DEFAULT_KEY_SIZE=2048

# Quantum Bit Error Rate (QBER) abort threshold limit in percentage (BB84 NIST standard: 11.0%)
REACT_APP_QBER_ABORT_THRESHOLD=11.0

# ------------------------------------------------------------------------------
# 5. REPOSITORY & EXTERNAL LINKS
# ------------------------------------------------------------------------------
REACT_APP_REPOSITORY_URL=https://github.com/Charan-718/Quantum-Keydistribution

# ------------------------------------------------------------------------------
# 6. BUILD SYSTEM OPTIMIZATIONS
# ------------------------------------------------------------------------------
# Disable source maps in production to keep distribution bundles lightweight & secure
GENERATE_SOURCEMAP=false
